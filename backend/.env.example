# Application Settings
APP_NAME=BYC AI Command & Control Platform
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/main_crowd_ai
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/main_crowd_ai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Configuration (Pub/Sub & Caching)
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
JWT_SECRET_KEY=byc_super_secret_jwt_key_khairatabad_2026_production_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal AI Service API Key (Service-to-Service)
AI_SERVICE_API_KEY=byc_ai_internal_service_token_2026

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Media Storage
MEDIA_ROOT=media
STORAGE_TYPE=local

# Feature Flags
FRS_ENABLED=true
AI_ENABLED=true
RTSP_ENABLED=false
PREDICTIONS_ENABLED=true
