# ==============================================================================
# CPU Frontend Instance Environment Configuration (.env)
# Copy this file to .env on the CPU instance before running docker compose
# ==============================================================================

# Port to expose frontend on host (default: 80)
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# MODE A: Reverse Proxy Mode (STRONGLY RECOMMENDED)
# ------------------------------------------------------------------------------
# In this mode, Nginx on the CPU instance proxies /api and /ws to your GPU instance.
# The user's browser only connects to port 80 of your CPU instance.
# NO CORS issues, and GPU instance port 8000 only needs to allow traffic from this CPU instance!
# Set BACKEND_URL to your GPU instance IP (use private IP if in same AWS VPC / cloud network):
BACKEND_URL=http://<GPU_INSTANCE_IP_OR_DNS>:8000

# Leave VITE_API_BASE_URL and VITE_WS_URL empty for Mode A
VITE_API_BASE_URL=
VITE_WS_URL=

# ------------------------------------------------------------------------------
# MODE B: Direct Browser Connection Mode (Alternative)
# ------------------------------------------------------------------------------
# If you want the client's browser to directly connect to the GPU instance port 8000:
# VITE_API_BASE_URL=http://<GPU_INSTANCE_PUBLIC_IP>:8000
# VITE_WS_URL=ws://<GPU_INSTANCE_PUBLIC_IP>:8000
# (Remember to also add http://<CPU_INSTANCE_IP> to CORS_ORIGINS on the GPU backend)
