# ==============================================================================
# GPU Instance Environment Configuration (.env)
# Copy this file to .env on the GPU instance before running docker compose
# ==============================================================================

# PostgreSQL Credentials (Self-hosted inside docker container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_2026
POSTGRES_DB=main_crowd_ai

# Security & JWT Token (generate using: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_strong_random_secret_min_32_chars
AI_SERVICE_API_KEY=replace_with_strong_random_internal_key
ADMIN_PASSWORD=replace_with_strong_admin_password

# CORS: Add your Frontend CPU Instance public IP / domain name
# Examples:
# CORS_ORIGINS=http://54.123.45.67,http://frontend.yourdomain.com,http://localhost:5173
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80

# Physical Camera RTSP Stream
RTSP_ENABLED=true
RTSP_URL=rtsp://admin:camera_password@192.168.0.102:554/Streaming/Channels/101

# AI & GPU Settings
USE_CUDA=true
MODEL_NAME=buffalo_l
DET_SIZE=640
MATCH_THRESHOLD=0.60
